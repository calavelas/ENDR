image:
  repository: {{ image_repository }}
  tag: {{ image_tag }}
  pullPolicy: IfNotPresent

service:
  port: {{ port }}

# Deployment environment variables — developer-tunable (e.g. robot calibration).
# Edit these via the portal; the deployment template renders them from here.
{%- if env %}
env:
{%- for key, value in env.items() %}
  {{ key }}: "{{ value }}"
{%- endfor %}
{%- else %}
env: {}
{%- endif %}

resources:
  requests:
    cpu: {{ requests_cpu }}
    memory: {{ requests_memory }}
  limits:
    cpu: {{ limits_cpu }}
    memory: {{ limits_memory }}

httpRoute:
  enabled: {{ gateway_enabled }}
  pathPrefix: /
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: gateway-cloudflare
      namespace: gateway
  hostnames:
    - {{ gateway_host }}
